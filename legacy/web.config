<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS equivalent of .htaccess, for the same reason: assets/media/icons/*.svg
     and assets/media/mark.svg are loaded as CSS mask-image sources, and need
     to be served as image/svg+xml or some browsers render the icon as empty
     instead of falling back to a solid fill. Ignored entirely by Apache/XAMPP. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
  </system.webServer>
</configuration>
